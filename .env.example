# .env.example — copy to .env and fill in. NEVER commit .env (it is gitignored).
# Every variable the engine reads is listed here. Missing vars degrade gracefully:
# the affected source goes idle and says so (run `solver doctor` to see what's live).

# --- Historical ingest (Across) ---
# One free Etherscan key covers all chains via the Etherscan V2 multichain API
# (api.etherscan.io/v2/api?chainid=...). Note: V2 covers ~60 chains, NOT every
# long-tail L2 — chains it doesn't support are reported as skipped by `doctor`.
ETHERSCAN_API_KEY=

# --- Live ingest + gas: HTTP RPC (one endpoint per chain, three consumers) ---
# ACROSS_RPC_<CHAIN-NAME-UPPER> is chain-generic, not Across-specific — one
# configured endpoint per chain feeds: (1) the live Across poll (`--sources
# across`, checkpointed eth_getLogs on FundsDeposited — POLL-1), (2) the live
# OIF poll (`--sources oif`, same transport, on Open — InputSettlerEscrow is
# on-chain-verified on 4 chains, OIF-1/OIF-2), and (3) the gas ladder's
# eth_feeHistory rung (used by default on `live`, or with --live-gas on
# backtest). A chain without one is idle for live ingest (`solver doctor`
# shows per-source readiness) and gas falls back to Etherscan/static.
#
# POLL-1 replaced an earlier eth_subscribe("logs") WS push (ACROSS_WS_*/
# OIF_WS_*, no longer read): push volume is driven by real on-chain deposit
# activity, uncapped — polling instead gives a fixed request ceiling per chain
# (--poll-interval-secs on `solver live`, default 60s), independent of chain
# activity. The right trade for a shadow-only system that only ever measures
# post-hoc (CLAUDE.md's would_fill definition).
ACROSS_RPC_BASE=
ACROSS_RPC_ARBITRUM=
ACROSS_RPC_OPTIMISM=
ACROSS_RPC_ETHEREUM=

# --- Optional price overrides (live pricing, off by default) ---
# Seed the static fallback used by --live-prices when CoinGecko is unreachable
# (so ETH/BTC don't fall back to the hard-coded reference). Used only with
# --live-prices; the default static run ignores them (deterministic CI).
# PRICE_ETH_USD=
# PRICE_BTC_USD=

# --- Logging ---
# e.g. info | debug | solver=debug,solver_ingest=info
RUST_LOG=info
