# .env.example — copy to .env and fill in. NEVER commit .env (it is gitignored).
# Every variable the engine reads is listed here. Missing vars degrade gracefully:
# the affected source goes idle and says so (run `solver doctor` to see what's live).

# --- Historical ingest (Across) ---
# One free Etherscan key covers all chains via the Etherscan V2 multichain API
# (api.etherscan.io/v2/api?chainid=...). Note: V2 covers ~60 chains, NOT every
# long-tail L2 — chains it doesn't support are reported as skipped by `doctor`.
ETHERSCAN_API_KEY=

# --- Live shadow: Across (websocket RPC, one per origin chain) ---
# Must support eth_subscribe("logs"). Public nodes sometimes don't; if you see
# "eth_subscribe rejected", use a provider that does (e.g. a private endpoint).
# Var name = ACROSS_WS_<CHAIN-NAME-UPPER>, matching ChainId::name().
ACROSS_WS_BASE=
ACROSS_WS_ARBITRUM=
ACROSS_WS_OPTIMISM=

# --- Live shadow: OIF (websocket RPC, one per chain) ---
# NOTE: the OIF InputSettler address is currently UNVERIFIED (see PROJECT-STATUS).
# Keep OIF idle until the address is confirmed on-chain. Testnet is the safe place
# to exercise it (e.g. OIF_WS_OPTIMISM_SEPOLIA).
# OIF_WS_OPTIMISM_SEPOLIA=
# OIF_WS_BASE=

# --- Optional price overrides (live pricing, off by default) ---
# Used only with --live-prices; otherwise static feed is used (deterministic CI).
# PRICE_ETH_USD=
# PRICE_BTC_USD=

# --- Logging ---
# e.g. info | debug | solver=debug,solver_ingest=info
RUST_LOG=info
