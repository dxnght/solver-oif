# solver.env — server-side secrets for solver-live.service.
# Copy to /opt/solver/solver.env, fill in, then: chmod 600 && chown solver:solver.
# These are read into the process env; the dashboard NEVER serves them.
#
# Plain `KEY=value` only — NO `export ` prefix. systemd's `EnvironmentFile=`
# is not a shell; a line starting with `export ` is a single invalid token
# and gets silently dropped ("Ignoring invalid environment assignment" in
# `journalctl -u solver-live`), which reads as a quiet idle source, not an
# error — easy to miss (learned live, 2026-08-05).

# --- HTTP RPC per chain — ONE endpoint, THREE consumers (POLL-1). ----------
# ACROSS_RPC_<CHAIN> is chain-generic, not Across-specific: it feeds (1) the
# live Across poll (checkpointed eth_getLogs on FundsDeposited), (2) the live
# OIF poll (same transport, on Open — needs --sources across,oif to matter),
# and (3) the gas ladder's eth_feeHistory rung. Without ACROSS_RPC_<CHAIN>
# that chain is idle for live ingest (logged at startup) and gas falls back
# to Etherscan/static.
#
# POLL-1 (2026-08-18): this replaced a WS eth_subscribe push
# (ACROSS_WS_<CHAIN>/OIF_WS_<CHAIN> — no longer read, safe to delete from an
# existing solver.env). The push billed one Infura request per on-chain
# deposit — uncapped, driven by real Across traffic across 3 chains 24/7 —
# and alone was enough to eat a meaningful share of the free daily quota
# every night. Polling (default 60s, --poll-interval-secs on the ExecStart
# line) gives a fixed, predictable request ceiling per chain instead.
ACROSS_RPC_BASE=https://base-mainnet.infura.io/v3/<KEY>
ACROSS_RPC_ARBITRUM=https://arbitrum-mainnet.infura.io/v3/<KEY>
ACROSS_RPC_OPTIMISM=https://optimism-mainnet.infura.io/v3/<KEY>
ACROSS_RPC_ETHEREUM=https://mainnet.infura.io/v3/<KEY>
# Destination-side fills can land on Polygon too (GAS_RPC_CHAINS covers it
# even though it isn't a polled origin chain above).
ACROSS_RPC_POLYGON=https://polygon-mainnet.infura.io/v3/<KEY>

# --- Gas ladder rung 1: Etherscan V2 (one key, many chains). ----------------
ETHERSCAN_API_KEY=<KEY>

# info in production; raise to debug only when diagnosing.
RUST_LOG=info
